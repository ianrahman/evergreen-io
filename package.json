{
  "name": "evergreen-io",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build && bun build src/worker.ts --outfile=dist/_worker.js --target=browser",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "wrangler": "wrangler",
    "deploy": "bun run build && wrangler deploy",
    "deploy:staging": "bun run build && wrangler deploy --env staging",
    "deploy:prod": "bun run build && wrangler deploy --env production",
    "cf:dev": "wrangler dev",
    "cf:tunnel": "wrangler dev --remote --port 8788",
    "cf:tail": "wrangler tail",
    "cf:publish": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260515.1",
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@testing-library/svelte": "^5.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/bun": "^1.3.14",
    "@vitest/ui": "^4.1.6",
    "jsdom": "^29.1.1",
    "svelte": "^5.55.7",
    "svelte-check": "^4.4.8",
    "tslib": "^2.8.1",
    "vite": "^8.0.13",
    "vitest": "^4.1.6",
    "wrangler": "^4.92.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {}
}
